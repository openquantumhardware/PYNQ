# SPDX-License-Identifier: BSD-3-Clause
#
# Builds libvrfdc.so from the AMD VRFDC driver sources staged by pre.sh.
#
# Unlike the RFSoC xrfdc package, which compiles the bare-metal driver with
# -D__BAREMETAL__ against libmetal *stubs*, the Versal driver ships a real
# Linux build (Makefile.Linux) that links against libmetal proper. libmetal
# does the device discovery, so the converter has to be visible in sysfs --
# see the note in xvrfdc/__init__.py.

PACKAGE   := xvrfdc
LIBRARY   := lib$(PACKAGE:x%=%).so
VRFDC_SRC := vrfdc_src

LIBMETAL_REPO := https://github.com/OpenAMP/libmetal.git
LIBMETAL_REF  := v2024.05.0
LIBMETAL_DIR  := libmetal
LIBMETAL_INS  := $(CURDIR)/libmetal-install

CFLAGS  += -fPIC -O2 -I$(LIBMETAL_INS)/include
LDFLAGS += -L$(LIBMETAL_INS)/lib

# metal_shim.c supplies the metal_init() call libvrfdc leaves to its caller.
SRCS := $(wildcard $(VRFDC_SRC)/*.c) metal_shim.c
OBJS := $(SRCS:.c=.o)

SIZE_PY := $(PACKAGE)/_size.py

all: $(LIBRARY) $(SIZE_PY)

# The struct sizes have to be measured, not guessed: xvrfdc.h wraps
# everything in #pragma pack(), which cffi cannot see, and this package
# declares the structs it uses by hand in xvrfdc_functions.c. A hand
# declaration that is the wrong size does not fail -- it reads and writes at
# the wrong offsets, which is how XVRFdc_Mixer_Settings once came out 40
# bytes instead of 33 and programmed the NCO from whatever landed there.
# Measured here so __init__.py can check its own idea against the target's.
$(SIZE_PY): $(VRFDC_SRC)/xvrfdc.h | libmetal
	@printf '#include <stdio.h>\n#include "xvrfdc.h"\nint main(void){\nprintf("_SIZE = %%zu\\n", sizeof(XVRFdc));\nprintf("_MIXER_SIZE = %%zu\\n", sizeof(XVRFdc_Mixer_Settings));\nprintf("_INTR_ALL_SIZE = %%zu\\n", sizeof(XVRFdc_IntrDataAll));\nreturn 0;}\n' > .sizeof_probe.c
	$(CC) $(CFLAGS) -I$(VRFDC_SRC) .sizeof_probe.c -o .sizeof_probe $(LDFLAGS) -lmetal
	@out=$$(LD_LIBRARY_PATH=$(LIBMETAL_INS)/lib ./.sizeof_probe); \
	 if [ "$$(printf '%s\n' "$$out" | grep -c '= [1-9]')" -ne 3 ]; then \
	   echo "ERROR: could not measure the struct sizes"; exit 1; \
	 fi; \
	 { echo '# Generated by the Makefile -- struct sizes on this target.'; \
	   echo '# Checked against the hand declarations at import time.'; \
	   printf '%s\n' "$$out"; } > $@; \
	 printf '%s\n' "$$out" | sed 's/^/  /'
	@rm -f .sizeof_probe .sizeof_probe.c

# Order-only, so libmetal is built before the first object but a rebuilt
# libmetal does not force every object to recompile. Without this, "make" in
# a fresh tree starts compiling the driver -- whose headers include
# metal/io.h -- before libmetal has been installed, and fails on the first
# source file. It only ever worked because the tree already had libmetal
# from an earlier build.
$(OBJS): | libmetal

$(LIBRARY): $(OBJS)
	$(CC) $(LDFLAGS) $(OBJS) -shared -Wl,-soname,$(LIBRARY) \
		-o $(LIBRARY) -lmetal -lm

%.o: %.c
	$(CC) $(CFLAGS) -I$(VRFDC_SRC) -c $< -o $@

# libmetal is not packaged by Ubuntu; build it from OpenAMP.
libmetal: $(LIBMETAL_INS)/lib/libmetal.so

$(LIBMETAL_INS)/lib/libmetal.so:
	git clone --depth 1 -b $(LIBMETAL_REF) $(LIBMETAL_REPO) $(LIBMETAL_DIR)
	cmake -S $(LIBMETAL_DIR) -B $(LIBMETAL_DIR)/build \
		-DCMAKE_INSTALL_PREFIX=$(LIBMETAL_INS) \
		-DWITH_DOC=OFF -DWITH_TESTS=OFF -DWITH_EXAMPLES=OFF
	cmake --build $(LIBMETAL_DIR)/build --target install -j$(shell nproc)
	install -m 0644 $(LIBMETAL_INS)/lib/libmetal.so* /usr/lib/ || true
	ldconfig

# --no-deps is not optional. This package declares pynq as a requirement,
# and a board image runs a PYNQ that has been patched in place; letting pip
# resolve that dependency invites it to replace the patched tree with a
# stock wheel from PyPI, and to drag pynqmetadata back to an older release
# along with it. Everything this needs is already on the image.
install: all
	cp $(LIBRARY) $(PACKAGE)/
	cp $(VRFDC_SRC)/xvrfdc.h $(PACKAGE)/ 2>/dev/null || true
	pip3 install --break-system-packages --no-deps --force-reinstall .

clean:
	rm -f $(OBJS) $(LIBRARY) $(SIZE_PY) .sizeof_probe .sizeof_probe.c
	rm -rf $(LIBMETAL_DIR) $(LIBMETAL_INS)

.PHONY: all install clean libmetal
