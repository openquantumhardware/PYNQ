.crashReporter/
NA/
hd_visual/
*_error.dcp
.*.error.rst

# Hog
Projects/
bin/
.repo.yaml

# Golden implementation outputs (build with `make -C golden`)
golden/golden/
golden/golden_bkp/
golden/golden_noc.ncr
golden/golden_routed.dcp

# Per-overlay Vivado project directories, named after the overlay
base/base/
rfloop/rfloop/
sgloop/sgloop/
__pycache__/
